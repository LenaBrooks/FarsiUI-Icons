{
  "name": "@farsiui/icons",
  "version": "0.1.0",
  "description": "React icon components for Iranian brands and services",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/named-icons.d.ts",
      "import": "./dist/named-icons.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:persian-labs": "node scripts/generate-persian-labs.mjs",
    "generate:aasaam": "node scripts/generate-aasaam.mjs",
    "generate:persian-simple-icons": "node scripts/generate-persian-simple-icons.mjs",
    "generate:logos-per-service": "node scripts/generate-logos-per-service.mjs",
    "generate:logos-per-banks": "node scripts/generate-logos-per-banks.mjs",
    "generate:devicons": "node scripts/generate-devicons.mjs",
    "generate:crypto": "node scripts/generate-crypto.mjs",
    "generate:manual": "node scripts/generate-manual.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "tsup",
    "build:web": "vite build --config vite.config.ts",
    "build:icons": "npm run generate && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svgo": "^4.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "icons",
    "iran",
    "brands",
    "farsiui",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/farsiui/icons"
  },
  "engines": {
    "node": ">=18"
  }
}
