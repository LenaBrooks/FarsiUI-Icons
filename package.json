{
  "name": "@farsiui/icons",
  "version": "0.2.6",
  "description": "Iranian brand React icons — CLI copy into your project. https://icons.FarsiUI.ir",
  "license": "MIT",
  "type": "module",
  "bin": {
    "farsiui-icons": "./cli/index.mjs"
  },
  "files": [
    "cli",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:persian-labs": "node scripts/generate-persian-labs.mjs",
    "generate:aasaam": "node scripts/generate-aasaam.mjs",
    "generate:persian-simple-icons": "node scripts/generate-persian-simple-icons.mjs",
    "generate:logos-per-service": "node scripts/generate-logos-per-service.mjs",
    "generate:logos-per-banks": "node scripts/generate-logos-per-banks.mjs",
    "generate:devicons": "node scripts/generate-devicons.mjs",
    "generate:crypto": "node scripts/generate-crypto.mjs",
    "generate:social": "node scripts/generate-social.mjs",
    "generate:manual": "node scripts/generate-manual.mjs",
    "generate:registry": "node scripts/generate-registry.mjs",
    "generate:lucide-registry": "node scripts/generate-lucide-registry.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "tsup && node scripts/generate-dts.mjs",
    "build:web": "vite build --config vite.config.ts",
    "build:icons": "npm run generate && npm run build",
    "generate:dts": "node scripts/generate-dts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svgo": "^4.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "icons",
    "iran",
    "brands",
    "farsiui",
    "svg",
    "cli"
  ],
  "homepage": "https://icons.FarsiUI.ir",
  "repository": {
    "type": "git",
    "url": "https://github.com/farsiui/icons"
  },
  "engines": {
    "node": ">=18"
  }
}
